rules_version = '2';

// Fairview Farm Fall Classic — Firestore security rules
// Paste this into Firebase console → Firestore Database → Rules, then Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // The tournament admin: signed in with Google using this verified email.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['reidroberge8@gmail.com'];
    }

    // Golfers are signed in automatically (anonymous sign-in).
    function signedIn() {
      return request.auth != null;
    }

    // Everyone can read everything; only the admin can change settings,
    // players, teams, course, rules and photos.
    match /{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Scores: any golfer can enter or correct hole scores.
    match /scores/{playerId} {
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['h', 'by'])
        && request.resource.data.h is map;
      allow delete: if isAdmin();
    }

    // Trash Talk chat: any golfer can post; only the admin can delete.
    match /chat/{messageId} {
      allow create: if signedIn()
        && request.resource.data.t is string
        && request.resource.data.t.size() > 0
        && request.resource.data.t.size() <= 280
        && request.resource.data.kind in ['msg', 'auto'];
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
